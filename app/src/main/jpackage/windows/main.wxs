<?xml version="1.0" ?>
<!--
  Third-party adapted source; this file is not covered by any license later
  selected for the project's original source.

  Upstream: Eclipse Adoptium OpenJDK 25u, tag jdk-25.0.4+7
  Path: src/jdk.jpackage/windows/classes/jdk/jpackage/internal/resources/main.wxs
  Source commit recorded by the build JDK: a2ce02c38bc9
  Unmodified template SHA-256:
    932C805A5B28BF73844540BDF239F3CAAB943F01DBBAEE0160973A00B6B05120
  License: GPL-2.0-only for this template. The upstream file contains no
  Classpath Exception designation; see legal/openjdk-jpackage/OPENJDK-LICENSE.txt.

  Modified by the EVE Static Map Planner project beginning 2026-08-20:
  converted from WiX 3 authoring to WiX 4, added the guarded major-upgrade
  RemoveFolderEx suppression, and added the per-user MCP PATH component.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else ?>
    <?define JpInstallScope="perUser"?>
  <?endif ?>

  <?define JpProductLanguage=1033 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif ?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif ?>

  <!-- Final 0.6.0 RC identity. It intentionally replaces the discarded 0.6.0 pre-release MSI. -->
  <Package Name="$(var.JpAppName)" Language="$(var.JpProductLanguage)" Version="$(var.JpAppVersion)" Manufacturer="$(var.JpAppVendor)" UpgradeCode="$(var.JpProductUpgradeCode)" InstallerVersion="$(var.JpInstallerVersion)" Compressed="$(var.JpCompressedMsi)" ProductCode="{00771A4A-EAAA-492C-9912-5A58EF3D323E}" Scope="$(var.JpInstallScope)">
    <SummaryInformation Manufacturer="$(var.JpAppVendor)" Description="$(var.JpAppDescription)" />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)" Property="JP_UPGRADABLE_FOUND" Maximum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMaximum="yes" />
      <UpgradeVersion OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)" Property="JP_DOWNGRADABLE_FOUND" Minimum="$(var.JpAppVersion)" MigrateFeatures="yes" IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <!-- A major upgrade must release every product runtime file before the old product is removed. -->
    <util:CloseApplication Id="JpCloseMainApplication" Target="EVE Static Map Planner.exe" CloseMessage="yes" ElevatedCloseMessage="yes" Timeout="5" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="JpCloseStableMcpApplication" Target="eve-map-mcp.exe" Timeout="2" TerminateProcess="0" RebootPrompt="no" />
    <util:CloseApplication Id="JpCloseDisplayMcpApplication" Target="EVE Map MCP Bridge.exe" Timeout="2" TerminateProcess="0" RebootPrompt="no" />

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif ?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif ?>

    <Binary Id="JpCaDll" SourceFile="wixhelper.dll" />
    <CustomAction Id="JpFindRelatedProducts" BinaryRef="JpCaDll" DllEntry="FindRelatedProductsEx" />

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="Files" />
      <ComponentGroupRef Id="FileAssociations" />
      <ComponentGroupRef Id="FragmentOsCondition" />
      <ComponentRef Id="JpEveMapMcpPath" />
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <!--
      JDK 25.0.4+7 jpackage gives its generated RemoveFolderEx this property.
      Clear only that path during RemoveExistingProducts so a major upgrade cannot
      schedule recursive removal of the co-located application data.
    -->
    <CustomAction Id="JpSuppressRemoveFolderExDuringUpgrade" Property="RM_RF48431AECBD69377EA800D62616352F20" Value="" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif ?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif ?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif ?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON" />
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)" />
    <?endif ?>

    <UIRef Id="JpUI" />

    <InstallExecuteSequence>
      <Custom Action="JpSetARPINSTALLLOCATION" After="CostFinalize" Condition="Not Installed" />
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize" Condition="Not Installed" />
      <Custom Action="JpSetARPCONTACT" After="CostFinalize" Condition="Not Installed" />
      <Custom Action="JpSetARPSIZE" After="CostFinalize" Condition="Not Installed" />
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize" Condition="Not Installed" />
      <?endif ?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize" Condition="Not Installed" />
      <?endif ?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize" Condition="Not Installed" />
      <?endif ?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="JpFindRelatedProducts" Condition="JP_UPGRADABLE_FOUND" />
      <?endif ?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="JpFindRelatedProducts" Condition="JP_DOWNGRADABLE_FOUND" />
      <?endif ?>
      <LaunchConditions Before="AppSearch" />
      <Custom Action="JpSuppressRemoveFolderExDuringUpgrade" After="AppSearch" Condition="UPGRADINGPRODUCTCODE" />
      <Custom Action="Wix4CloseApplications_X64" Before="RemoveExistingProducts" />
      <RemoveExistingProducts Before="CostInitialize" />
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="JpFindRelatedProducts" After="FindRelatedProducts" />
    </InstallUISequence>
  </Package>

  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="JpEveMapMcpPath" Guid="{44EBD78B-F3BB-5167-85E4-BD330EB5F4DF}" Bitness="always64">
        <RegistryKey Root="HKCU" Key="Software\Static Map Planner Project\EVE Static Map Planner">
          <RegistryValue Name="McpPathRegistration" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
        </RegistryKey>
        <Environment Id="JpEveMapMcpPathEnvironment" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="no" Permanent="no" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
